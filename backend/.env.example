# fathom-gate environment. Copy to .env, fill in, keep out of git.
# Your managed relying party id and app id from the World Developer Portal.
FATHOM_RP_ID=rp_replace_me
FATHOM_APP_ID=app_replace_me
# The RP signing key returned ONCE when the RP is configured in the portal.
# Store it in a secrets manager; it is only ever read from the environment.
WORLD_FATHOM_SIGNING_KEY=replace_me_hex_without_0x
# A long random bearer token. The same value is baked into the app build
# at release time (see the app README / release script).
FATHOM_GATE_TOKEN=replace_me_long_random
FATHOM_GATE_PORT=7902
FATHOM_GATE_HOST=127.0.0.1
FATHOM_GATE_DATA=./data
